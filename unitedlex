import requests, json

DASHBOARD_ID = "01f134fc8dce14e09fb047303ade2561"  # de la URL
HOST = spark.conf.get("spark.databricks.workspaceUrl")

# OJO: si esto no te devuelve token en tu contexto, usa un PAT desde secrets
TOKEN = dbutils.notebook.entry_point.getDbutils().notebook().getContext().apiToken().get()

headers = {
    "Authorization": f"Bearer {TOKEN}",
    "Content-Type": "application/json"
}

# 1) GET dashboard draft actual
get_url = f"https://{HOST}/api/2.0/lakeview/dashboards/{DASHBOARD_ID}"
resp = requests.get(get_url, headers=headers)
resp.raise_for_status()

dashboard = resp.json()
etag = dashboard.get("etag")
serialized = json.loads(dashboard["serialized_dashboard"])

# 2) Construir columnas dinámicas para Attendance Pivot
date_fields = [{"name": d, "expression": f"`{d}`"} for d in reversed(_date_labels)]
date_columns = [{"fieldName": d, "displayName": d} for d in reversed(_date_labels)]

fixed_fields = [
    {"name": "empId", "expression": "`empId`"},
    {"name": "name", "expression": "`name`"},
    {"name": "employee_status", "expression": "`employee_status`"},
    {"name": "last_inactive_date", "expression": "`last_inactive_date`"},
]
fixed_columns = [
    {"fieldName": "empId", "displayName": "Emp ID"},
    {"fieldName": "name", "displayName": "Name"},
    {"fieldName": "employee_status", "displayName": "Employee Status"},
    {"fieldName": "last_inactive_date", "displayName": "Last Inactive Date"},
]

# 3) Encontrar la página Attendance Pivot y actualizar el widget correcto
updated = False

for page in serialized["pages"]:
    if page.get("displayName") == "Attendance Pivot":
        for item in page.get("layout", []):
            w = item.get("widget", {})
            if w.get("name") == "attendance_full_table":
                # query fields
                w["queries"][0]["query"]["fields"] = fixed_fields + date_fields
                # visible columns
                w["spec"]["encodings"]["columns"] = fixed_columns + date_columns
                updated = True
                break

if not updated:
    raise Exception("No se encontró el widget 'attendance_full_table' en la página 'Attendance Pivot'.")

# 4) PATCH draft con etag
patch_body = {
    "serialized_dashboard": json.dumps(serialized),
    "etag": etag
}

patch_url = f"https://{HOST}/api/2.0/lakeview/dashboards/{DASHBOARD_ID}"
patch_resp = requests.patch(patch_url, headers=headers, json=patch_body)
patch_resp.raise_for_status()

print("Draft dashboard updated successfully.")

# 5) Re-publicar
publish_url = f"https://{HOST}/api/2.0/lakeview/dashboards/{DASHBOARD_ID}/published"
publish_resp = requests.post(
    publish_url,
    headers=headers,
    json={"embed_credentials": False}
)
publish_resp.raise_for_status()

print("Published dashboard updated successfully.")