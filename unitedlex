        how="left"
    )
    .join(
        df_total_hours_daily.alias("t"),
        on=[
            F.col("r.person_number") == F.col("t.person_number"),
            F.col("r.work_date") == F.col("t.work_date")
        ],
        how="left"
    )
    .join(
        df_clock_presence.alias("c"),
        on=[
            F.col("r.person_number") == F.col("c.person_number"),
            F.col("r.work_date") == F.col("c.work_date")
        ],
        how="left"
    )
    .select(
        F.col("r.person_number"),
        F.col("r.employee_name"),
        F.col("r.work_date"),
        F.col("r.work_location"),
        F.col("r.holiday_location"),
        F.col("r.employee_status"),
        F.col("r.last_inactive_date"),
        F.col("r.is_weekend"),
        F.when(F.col("h.holiday_name").isNotNull(), F.lit(True)).otherwise(F.lit(False)).alias("is_holiday"),
        F.col("h.holiday_name"),
        F.when(F.col("p.absence_type").isNotNull(), F.lit(True)).otherwise(F.lit(False)).alias("has_pto"),
        F.col("p.absence_type"),
        F.coalesce(F.col("p.is_half_day"), F.lit(False)).alias("is_half_day"),
        F.coalesce(F.col("p.is_sick"), F.lit(False)).alias("is_sick"),
        F.coalesce(F.col("c.has_clock_activity"), F.lit(False)).alias("has_clock_activity"),
        F.coalesce(F.col("w.working_hours"), F.lit(0.0)).alias("working_hours"),
        F.coalesce(F.col("t.total_hours"), F.col("w.working_hours"), F.lit(0.0)).alias("total_hours"),
        F.coalesce(F.col("t.clock_segments"), F.lit(0)).alias("clock_segments"),
        F.coalesce(F.col("w.narrative"), F.lit(None).cast(StringType())).alias("narrative"),
        F.coalesce(F.col("w.missing_clockout"), F.lit(0)).alias("missing_clockout"),
        F.coalesce(F.col("w.clockinoutentryids"), F.lit("")).alias("clockinoutentryids"),
        F.coalesce(F.col("w.integration_status"), F.lit("")).alias("integration_status"),
    )
)

# Truth table:
# 1) holiday + clock -> Present
# 2) holiday + no clock -> Holiday
# 3) weekend + clock -> Present
# 4) weekend + no clock -> blank/Weekend
# 5) half-day + clock -> Present
# 6) half-day + no clock -> PTO
# 7) sick -> Sick
# 8) full-day PTO -> PTO
# 9) clock -> Present
# 10) else -> Absent
df_attendance_daily = (
    df_base
    .withColumn(
        "attendance_status",
        F.when((F.col("is_holiday") == True) & (F.col("has_clock_activity") == True), F.lit("Present"))
         .when((F.col("is_holiday") == True) & (F.col("has_clock_activity") == False), F.lit("Holiday"))
         .when((F.col("is_weekend") == True) & (F.col("has_clock_activity") == True), F.lit("Present"))
         .when((F.col("is_weekend") == True) & (F.col("has_clock_activity") == False),
               F.lit("" if SHOW_WEEKEND_AS_BLANK else "Weekend"))
         .when((F.col("has_pto") == True) & (F.col("is_half_day") == True) & (F.col("has_clock_activity") == True), F.lit("Present"))
         .when((F.col("has_pto") == True) & (F.col("is_half_day") == True) & (F.col("has_clock_activity") == False), F.lit("PTO"))
         .when((F.col("has_pto") == True) & (F.col("is_sick") == True), F.lit("Sick"))
         .when((F.col("has_pto") == True), F.lit("PTO"))
         .when((F.col("has_clock_activity") == True), F.lit("Present"))
         .otherwise(F.lit("Absent"))
    )
    .withColumn(
        "anomaly_full_day_pto_with_clock",
        F.when(
            (F.col("has_pto") == True)
            & (F.col("is_half_day") == False)
            & (F.col("is_sick") == False)
            & (F.col("has_clock_activity") == True),
            F.lit(True)
        ).otherwise(F.lit(False))
    )
    .withColumn(
        "anomaly_clock_but_zero_working",
        F.when(
            (F.col("has_clock_activity") == True) & (F.col("working_hours") <= 0),
            F.lit(True)
        ).otherwise(F.lit(False))
    )
)

# Si el estatus final no es Present, las horas reportables se ponen en 0
df_attendance_daily = (
    df_attendance_daily
    .withColumn(
        "working_hours_final",
        F.when(F.col("attendance_status") == "Present", F.round(F.col("working_hours"), 2)).otherwise(F.lit(0.0))
    )
    .withColumn(
        "total_hours_final",
        F.when(F.col("attendance_status") == "Present", F.round(F.col("total_hours"), 2)).otherwise(F.lit(0.0))
    )
    .withColumn(
        "ot_hours_final",
        F.when(
            F.col("attendance_status") == "Present",
            F.round(F.greatest(F.col("working_hours") - F.lit(float(STANDARD_HOURS)), F.lit(0.0)), 2)
        ).otherwise(F.lit(0.0))
    )
)

