# Base silver joined to 252 header
df_clock_252 = (
    spark.table(SRC_CLOCK).alias("s")
    .join(df_header_252.alias("h"), on="clockinoutentryid", how="inner")
    .select(
        "clockinoutentryid",
        F.col("h.person_number").alias("person_number"),
        F.col("h.work_date").alias("work_date"),
        F.col("s.entrydatetime").alias("entrydatetime"),
        F.col("s.punchtype").alias("punchtype"),
        F.col("s.narrative").alias("narrative"),
        F.col("h.header_totalhours").alias("header_totalhours"),
        F.col("h.missingclockout").alias("missing_clockout"),
        F.col("h.integrationstatus").alias("integration_status")
    )
)

# Working hours = max(header totalhours) per employee-day
df_working_daily = (
    df_clock_252
    .groupBy("person_number", "work_date")
    .agg(
        F.max("header_totalhours").alias("working_hours"),
        F.max("narrative").alias("narrative"),
        F.max(F.coalesce(F.col("missing_clockout"), F.lit(0))).alias("missing_clockout"),
        F.concat_ws(",", F.collect_set("clockinoutentryid")).alias("clockinoutentryids"),
        F.max("integration_status").alias("integration_status")
    )
)

# Presence flag = any clock row
df_clock_presence = (
    df_clock_252
    .groupBy("person_number", "work_date")
    .agg(F.count(F.lit(1)).alias("clock_event_rows"))
    .withColumn("has_clock_activity", F.lit(True))
)

# Total hours = sum of Clock In -> next Clock Out segments only
w_clock = Window.partitionBy("person_number", "work_date").orderBy(F.col("entrydatetime"))

df_punches = (
    df_clock_252
    .filter(F.col("punchtype").isin(START_PUNCHES + END_PUNCHES))
    .select("person_number", "work_date", "entrydatetime", "punchtype")
)

df_segments = (
    df_punches
    .withColumn("next_punchtype", F.lead("punchtype").over(w_clock))
    .withColumn("next_entrydatetime", F.lead("entrydatetime").over(w_clock))
    .filter(F.col("punchtype").isin(START_PUNCHES))
    .filter(F.col("next_punchtype").isin(END_PUNCHES))
    .filter(F.col("next_entrydatetime").isNotNull())
    .filter(F.col("next_entrydatetime") > F.col("entrydatetime"))
    .withColumn(
        "segment_hours",
        (F.col("next_entrydatetime").cast("long") - F.col("entrydatetime").cast("long")) / F.lit(3600.0)
    )
    .filter((F.col("segment_hours") >= 0) & (F.col("segment_hours") <= 24))
)

df_total_hours_daily = (
    df_segments
    .groupBy("person_number", "work_date")
    .agg(
        F.round(F.sum("segment_hours"), 2).alias("total_hours"),
        F.count(F.lit(1)).alias("clock_segments")
    )
)

print("Working daily rows:", df_working_daily.count())
