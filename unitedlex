# 8b. HOURS REPORT (long format — no spaces in column names for Delta)
def decimal_to_hhmm(col_name):
    total_min = F.round(F.coalesce(F.col(col_name), F.lit(0.0)) * 60).cast("long")
    h = (total_min / F.lit(60)).cast("long")
    m = (total_min % F.lit(60)).cast("long")
    return F.concat(
        h.cast("string"),
        F.lit(":"),
