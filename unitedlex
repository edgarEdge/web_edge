def _clean_str(c):
    s = F.trim(F.col(c).cast("string"))
    return F.when(
        s.isNull() | s.isin("", "-", "null", "NULL", "None"),
        F.lit(None)
    ).otherwise(s)

def parse_ts_any(c):
    s = _clean_str(c)
    s_norm = F.regexp_replace(F.regexp_replace(s, "T", " "), "/", "-")

    return (
        F.when(
            s_norm.rlike(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}[+-]\d{2}:\d{2}$"),
            F.to_timestamp(s_norm, "yyyy-MM-dd HH:mm:ss.SSSXXX")
        )
        .when(
            s_norm.rlike(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}$"),
            F.to_timestamp(s_norm, "yyyy-MM-dd HH:mm:ss.SSS")
        )
        .when(
            s_norm.rlike(r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$"),
            F.to_timestamp(s_norm, "yyyy-MM-dd HH:mm:ss")
        )
        .when(
            s_norm.rlike(r"^\d{12}$"),
            F.to_timestamp(s_norm, "yyyyMMddHHmm")
        )
        .otherwise(F.to_timestamp(s_norm))
    )

def parse_date_any(c):
    s = _clean_str(c)
    s_norm = F.regexp_replace(F.regexp_replace(s, "T", " "), "/", "-")

    return (
        F.when(
            s_norm.rlike(r"^\d{4}-\d{2}-\d{2}$"),
            F.to_date(s_norm, "yyyy-MM-dd")
        )
        .when(
            s_norm.rlike(r"^\d{4}/\d{2}/\d{2}$"),
            F.to_date(F.regexp_replace(s, "/", "-"), "yyyy-MM-dd")
        )
        .when(
            s_norm.rlike(r"^\d{4}-\d{2}-\d{2} .*"),
            F.to_date(parse_ts_any(c))
        )
        .otherwise(F.to_date(s_norm))
    )

