def map_holiday_location(col_work_location_name):
    c = F.lower(F.coalesce(col_work_location_name, F.lit("")))
    return (
        F.when(c.contains("gurugram"), F.lit("Gurugram"))
         .when(c.contains("bengaluru"), F.lit("Bengaluru"))
         .when(c.contains("virtual"), F.lit("Virtual Location-IN"))
         .otherwise(F.lit(None).cast(StringType()))
    )

def build_employee_name():
    first_name = F.coalesce(F.col("EmployeePreferredName"), F.col("EmployeeFirstname"), F.lit(""))
    last_name  = F.coalesce(F.col("PreferredLastName"), F.col("EmployeeLastName"), F.lit(""))
    return F.trim(F.regexp_replace(F.concat_ws(" ", first_name, last_name), r"\s+", " "))

